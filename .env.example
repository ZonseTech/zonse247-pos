NODE_ENV=development
APPNAME=zonse247-pos
AUTO_SYNC_ENABLED=false
APPLICATION_ENVIRONMENT=desktop
APPLICATION_OFFLINE_MODE=false

# client config
VITE_API_URL=http://127.0.0.1:3001/api/v1
# VITE_API_URL=http://10.0.2.2:3001/api/v1
VITE_APP_TITLE=Zonse247 POS
VITE_DEBUG_MODE=true
VITE_APP_CLIENT_TYPE=web

# API Configuration
API_VERSION=v1
API_PREFIX=/api
API_HOST=127.0.0.1
API_PORT=3001

SERVER_PORT=3000
SERVER_HOST=127.0.0.1

# Server Configuration
TRUST_PROXY=true
SERVER_TIMEOUT=30000

# JWT Configuration
JWT_SECRET=
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# Security Configuration
BCRYPT_SALT_ROUNDS=10
CORS_REQUEST_SIZE_LIMIT=10mb
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5
ACCOUNT_CREATION_LIMIT=5

# For local SQLite
DATABASE_OFFLINE_MODE=true
DATABASE_PROVIDER=sqlite
DATABASE_URL="file:./local.db"