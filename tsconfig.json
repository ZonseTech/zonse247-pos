{
  "compilerOptions": {
    "target": "ESNext",
    "module": "commonjs",
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": false,
    "sourceMap": true,
    "baseUrl": ".",
    "outDir": "dist",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "typeRoots": ["./node_modules/@types", "src/types"],
    "types": ["vite/client"],
    "jsx": "react-jsx"
  },
  "ts-node": {
    "files": true
  },
  "exclude": ["node_modules", "dist", ".vite"]
}
